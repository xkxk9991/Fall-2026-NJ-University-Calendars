<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nascent.calendars-push</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/xunkaichen/Desktop/Claude CoWork OS/Campus Outreach/Fall 2026 Calendars/github-repo/push-calendars.sh</string>
    </array>

    <!-- Every hour. The script exits immediately when nothing changed, so
         this is effectively free. Hourly rather than weekly because Cowork
         scheduled tasks only run while the app is open - if it's closed on
         Sunday morning, the refresh lands whenever you next launch it. -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- Also run once at login, to catch anything missed while powered off. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/xunkaichen/Library/Logs/campus-calendars-push.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xunkaichen/Library/Logs/campus-calendars-push.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <!-- Don't let a hung push pile up. -->
    <key>AbandonProcessGroup</key>
    <false/>
</dict>
</plist>
